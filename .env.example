# ============================================================
#  study-os 可选配置
#
#  【推荐】直接在网页「设置」里填 Base URL / API Key / 模型，
#         填完立刻生效，不用重启，也不用改这个文件。
#
#  这个文件只在下面两种情况下才需要：
#    1. 你想锁定一套默认值
#    2. 你想用环境变量管理密钥，不写进数据库
#
#  优先级：界面 > 本文件 > 内置默认
# ============================================================

PORT=7788
# 必须 0.0.0.0，否则同局域网的手机连不上
HOST=0.0.0.0

# ------------------------------------------------------------
# 识题模型（必须支持图片输入）
# 留空 = 用内置默认（DeepSeek 的 deepseek-flash）
# ------------------------------------------------------------
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# 备选：阿里百炼 / 通义千问（中文手写识别较强）
# VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VISION_MODEL=qwen-vl-plus

# 备选：智谱 GLM（glm-4v-flash 有免费额度，适合零成本跑通）
# VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# VISION_MODEL=glm-4v-flash

# ------------------------------------------------------------
# 写文模型（出变式题、写周报月报）
# 留空 = 自动复用识题模型那套配置
# ------------------------------------------------------------
TEXT_BASE_URL=
TEXT_API_KEY=
TEXT_MODEL=

# ------------------------------------------------------------
# 行为参数
# ------------------------------------------------------------

# 数据库和图片目录，默认 ./data
# DATA_DIR=

# 复习单每天最多放几道题（1-8）
SHEET_PER_DAY=4

# 多少天没再出错就自动归档为「已掌握」
ARCHIVE_AFTER_DAYS=30

# 识题时是否开启思考模式（关掉更快更便宜）
VISION_THINKING=off

# ------------------------------------------------------------
# 局域网保护（可选）
# 设了就要求访问带令牌；建议在网页「设置 → 局域网保护」里一键生成。
# 留空 = 同一 WiFi 下任何设备都能直接访问。
# ------------------------------------------------------------
# ACCESS_TOKEN=
